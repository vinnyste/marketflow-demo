{
  "expo": {
    "name": "MarketFlow Demo",
    "slug": "marketflow-demo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/marketflow-logo.png",
    "scheme": "marketflowdemo",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.marketflowdemo.app"
    },
    "android": {
      "package": "com.marketflowdemo.preview",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/marketflow-logo.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/marketflow-logo.png",
      "name": "Portal MarketFlow Demo",
      "shortName": "MarketFlow Admin"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/marketflow-logo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {}
  }
}
